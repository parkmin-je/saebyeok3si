{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/parkmin-je/retro-romance-shorts/schemas/timeline.schema.json",
  "title": "Render timeline",
  "type": "object",
  "required": ["schema_version", "fps", "width", "height", "duration_sec", "scenes", "bgm", "sfx"],
  "$defs": {
    "sec": { "type": "number", "minimum": 0 }
  },
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "fps": { "const": 30 },
    "width": { "const": 1080 },
    "height": { "const": 1920 },
    "duration_sec": { "type": "number", "minimum": 45, "maximum": 59 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["no", "start", "end", "image", "motion", "voice", "captions"],
        "properties": {
          "no": { "type": "integer", "minimum": 1 },
          "start": { "$ref": "#/$defs/sec" },
          "end": { "$ref": "#/$defs/sec" },
          "image": { "type": "string" },
          "motion": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["static", "zoom_in", "zoom_out", "pan_left", "pan_right", "push_in"] },
              "from": { "type": "number" },
              "to": { "type": "number" }
            }
          },
          "transition_in": {
            "type": "object",
            "required": ["type", "sec"],
            "properties": { "type": { "enum": ["cut", "fade", "crossfade"] }, "sec": { "$ref": "#/$defs/sec" } }
          },
          "voice": {
            "type": "array",
            "items": { "type": "object", "required": ["file", "start"], "properties": { "file": { "type": "string" }, "start": { "$ref": "#/$defs/sec" } } }
          },
          "captions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "start", "end"],
              "properties": { "text": { "type": "string", "maxLength": 14 }, "start": { "$ref": "#/$defs/sec" }, "end": { "$ref": "#/$defs/sec" } }
            }
          }
        }
      }
    },
    "bgm": {
      "type": ["object", "null"],
      "required": ["file", "gain_db"],
      "properties": { "file": { "type": "string" }, "gain_db": { "type": "number" }, "duck_under_voice_db": { "type": "number" } }
    },
    "sfx": {
      "type": "array",
      "items": { "type": "object", "required": ["file", "start"], "properties": { "file": { "type": "string" }, "start": { "$ref": "#/$defs/sec" }, "gain_db": { "type": "number" } } }
    }
  }
}
