{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/parkmin-je/retro-romance-shorts/schemas/script.schema.json",
  "title": "Episode script",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "era", "title", "logline", "theme", "target_duration_sec", "aspect_ratio", "style", "characters", "scenes", "upload"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "id": { "type": "string", "pattern": "^(19[0-9]0s|2000s)-\\d{3}$" },
    "era": { "type": "string", "pattern": "^(19[0-9]0s|2000s)$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 40 },
    "logline": { "type": "string", "minLength": 1, "maxLength": 200 },
    "theme": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
    "target_duration_sec": { "type": "number", "minimum": 45, "maximum": 59 },
    "aspect_ratio": { "const": "9:16" },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "negative", "bgm", "narrator_voice"],
      "properties": {
        "visual": { "type": "string", "minLength": 1 },
        "negative": { "type": "string" },
        "bgm": { "type": "string", "minLength": 1 },
        "narrator_voice": { "type": "string", "minLength": 1 }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "look", "voice"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z]$" },
          "name": { "type": "string", "minLength": 1 },
          "look": { "type": "string", "description": "Empty for voice-only characters (never drawn). G1 rejects {X} in image_prompt when look is empty." },
          "voice": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["no", "beat", "duration_sec", "location", "image_prompt", "motion_prompt", "narration", "dialogue", "captions", "sfx"],
        "properties": {
          "no": { "type": "integer", "minimum": 1 },
          "beat": { "enum": ["hook", "memory", "conflict", "turn", "ending"] },
          "duration_sec": { "type": "number", "minimum": 2, "maximum": 20 },
          "location": { "type": "string" },
          "image_prompt": { "type": "string", "minLength": 1 },
          "motion_prompt": { "type": "string" },
          "narration": { "type": "string" },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["speaker", "line"],
              "properties": {
                "speaker": { "type": "string", "pattern": "^[A-Z]$" },
                "line": { "type": "string", "minLength": 1 }
              }
            }
          },
          "captions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 14 } },
          "sfx": { "type": "string" }
        }
      }
    },
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yt_title", "ig_caption", "hashtags", "cover_text"],
      "properties": {
        "yt_title": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "#shorts" },
        "ig_caption": { "type": "string", "minLength": 1, "maxLength": 2200 },
        "hashtags": { "type": "array", "minItems": 3, "maxItems": 10, "items": { "type": "string", "pattern": "^#\\S+$" } },
        "cover_text": { "type": "string", "minLength": 1, "maxLength": 12 }
      }
    }
  }
}
